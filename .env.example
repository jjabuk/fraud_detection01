# Copy to .env (gitignored) and fill in your own paths.
# uv run reads .env automatically.

# Dagster instance runtime state. Keep this OUTSIDE dagster/, which holds
# only tracked config (dagster.yaml, workspace.yaml). See README for the
# one-time .dagster_home/dagster.yaml symlink setup.
DAGSTER_HOME=/absolute/path/to/fraud_detection01/.dagster_home

# So `fraud_detection` is importable without installing it as a package.
PYTHONPATH=/absolute/path/to/fraud_detection01/src

# ADC file scoped to this project's service account (see README —
# generated via `gcloud auth application-default login
# --impersonate-service-account=...`). Keep it outside any repo so it's
# never at risk of being committed, and separate from the global ADC file
# other GCP projects on this machine may overwrite.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/adc.json
